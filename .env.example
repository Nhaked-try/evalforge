# EvalForge Environment Configuration

# --- Model API Keys ---
OPENAI_API_KEY=sk-your-key
ANTHROPIC_API_KEY=sk-ant-your-key
TOGETHER_API_KEY=your-key
GROQ_API_KEY=your-key
HUGGINGFACE_TOKEN=hf_your_token

# --- Judge API Keys (can be same or different) ---
EVALFORGE_JUDGE_API_KEY=sk-your-judge-key
EVALFORGE_JUDGE_MODEL=gpt-4o

# --- Local Model ---
EVALFORGE_LOCAL_MODEL_PATH=/path/to/model
EVALFORGE_VLLM_HOST=http://localhost:8000/v1

# --- GPU ---
CUDA_VISIBLE_DEVICES=0
EVALFORGE_BATCH_SIZE=32
EVALFORGE_TENSOR_PARALLEL_SIZE=1

# --- Output ---
EVALFORGE_RESULTS_DIR=./results
EVALFORGE_CACHE_DIR=./.cache
EVALFORGE_REPORTS_DIR=./reports

# --- Concurrency ---
EVALFORGE_MAX_WORKERS=8
EVALFORGE_RATE_LIMIT_RPM=60

# --- Logging ---
EVALFORGE_LOG_LEVEL=INFO
